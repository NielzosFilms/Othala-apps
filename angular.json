{
    "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
    "version": 1,
    "cli": {
        "packageManager": "npm"
    },
    "newProjectRoot": "projects",
    "projects": {
        "othala-lib": {
            "projectType": "library",
            "root": "projects/othala-lib",
            "sourceRoot": "projects/othala-lib/src",
            "prefix": "othala",
            "architect": {
                "build": {
                    "builder": "@angular/build:ng-packagr",
                    "exports": {
                        "./theme/hagalaz": {
                            "sass": "./theme/hagalaz.scss"
                        },
                        "./theme/base": {
                            "sass": "./theme/base.scss"
                        }
                    },
                    "configurations": {
                        "production": {
                            "tsConfig": "projects/othala-lib/tsconfig.lib.prod.json"
                        },
                        "development": {
                            "tsConfig": "projects/othala-lib/tsconfig.lib.json"
                        }
                    },
                    "defaultConfiguration": "production"
                },
                "test": {
                    "builder": "@angular/build:unit-test",
                    "options": {
                        "tsConfig": "projects/othala-lib/tsconfig.spec.json"
                    }
                }
            }
        },
        "watchlist": {
            "projectType": "application",
            "schematics": {
                "@schematics/angular:component": {
                    "style": "scss"
                }
            },
            "root": "projects/watchlist",
            "sourceRoot": "projects/watchlist/src",
            "prefix": "app",
            "architect": {
                "build": {
                    "builder": "@angular/build:application",
                    "options": {
                        "browser": "projects/watchlist/src/main.ts",
                        "tsConfig": "projects/watchlist/tsconfig.app.json",
                        "inlineStyleLanguage": "scss",
                        "assets": [
                            {
                                "glob": "**/*",
                                "input": "projects/watchlist/public"
                            }
                        ],
                        "styles": ["projects/watchlist/src/styles.scss"],
                        "stylePreprocessorOptions": {
                            "includePaths": ["dist"]
                        }
                    },
                    "configurations": {
                        "production": {
                            "budgets": [
                                {
                                    "type": "initial",
                                    "maximumWarning": "500kB",
                                    "maximumError": "1MB"
                                },
                                {
                                    "type": "anyComponentStyle",
                                    "maximumWarning": "4kB",
                                    "maximumError": "8kB"
                                }
                            ],
                            "outputHashing": "all"
                        },
                        "development": {
                            "optimization": false,
                            "extractLicenses": false,
                            "sourceMap": true
                        }
                    },
                    "defaultConfiguration": "production"
                },
                "serve": {
                    "builder": "@angular/build:dev-server",
                    "configurations": {
                        "production": {
                            "buildTarget": "watchlist:build:production"
                        },
                        "development": {
                            "buildTarget": "watchlist:build:development"
                        }
                    },
                    "defaultConfiguration": "development"
                },
                "test": {
                    "builder": "@angular/build:unit-test"
                }
            }
        }
    }
}
